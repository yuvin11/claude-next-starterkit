# 환경 변수 예시 파일
# 이 파일을 복사해서 .env.local 파일을 만들고 실제 값을 입력하세요
# .env.local 파일은 .gitignore에 등록되어 Git에 커밋되지 않습니다

# 예시: 데이터베이스 URL
# DATABASE_URL=postgresql://user:password@localhost:5432/mydb

# 예시: 외부 API 키
# NEXT_PUBLIC_API_KEY=your_api_key_here

# NEXT_PUBLIC_ 접두사가 붙은 변수만 브라우저(클라이언트)에서 접근 가능합니다
# 그 외 변수는 서버에서만 접근 가능합니다 (보안상 안전)
